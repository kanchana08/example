pipeline {
    agent any
    tools {nodejs "npm"}
    environment {
     //   snykTokenId = credentials('snyk-api-token') 
        SNYK_API = "${env.SNYK_API}"  
    }

    stages {
        stage('checkout') {
            steps {
                    
          git branch: 'master', credentialsId: 'PAT', url: 'https://git.stldev.io:1305/pradeepkumar.n/angular-ng.git'

                

            }
        }
        stage('Build') {
            steps {
                echo 'Building...'
                sh "npm install"
                sh "npm run build"

            }
        }
        stage('Test') {
            steps {
                echo 'Running Snyk Test...'
                // Run Snyk Security test and output report in workspace
                snykSecurity(
                    snykInstallation: 'snyk@latest',
                    snykTokenId: 'snyk-token',
                    additionalArguments: '--report --report-file=snyk_report.html'
                )
            }
        }



        stage('Archive Report') {
            steps {
                echo 'Archiving Snyk Report...'
                archiveArtifacts artifacts: 'snyk_report.html', allowEmptyArchive: true
            }
        }


     
        stage('Deploy') {
            steps {
                echo 'Deploying...'
                // Your deploy steps go here
            }
        }
    }
  post {
    success {
        echo 'Sending email with Snyk report content...'
        script{
        // Read the Snyk report HTML content
       // Generate a link to the report in Jenkins
        def reportLink = "${env.BUILD_URL}artifact/snyk_report.html"

        // Send email with a link to the report
        emailext (
            to: "kanchanagm@stellaripl.com",
            subject: "Jenkins Build: ${currentBuild.currentResult} - ${env.JOB_NAME}",
            body: """
                ${currentBuild.currentResult}: Job ${env.JOB_NAME}\n
                More info: ${env.BUILD_URL}\n
                View the Snyk report here: <a href="${reportLink}">Snyk Report</a>
            """,
            mimeType: 'text/html' // Send as HTML
        )
    }

    }
  }
}
  
    

         

