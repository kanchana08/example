      pipeline {
    agent any
    tools {nodejs "npm"}
    environment {
        SNYK_API = "${env.SNYK_API}"  
    }

    stages {
        stage('checkout') {
            steps {
                git branch: 'master', credentialsId: 'PAT', url: 'https://git.stldev.io:1305/pradeepkumar.n/angular-ng.git'
            }
        }
        stage('Build') {
            steps {
                echo 'Building...'
                sh "npm install"
                sh "npm run build"
            }
        }
        stage('Test') {
            steps {
                echo 'Running Snyk Test...'
                snykSecurity(
                    snykInstallation: 'snyk@latest',
                    snykTokenId: 'snyk-token',
                    additionalArguments: '--report --report-file=snyk_report.html'
                )
            }
        }
        stage('Archive Report') {
            steps {
                echo 'Archiving Snyk Report...'
                archiveArtifacts artifacts: 'snyk_report.html', allowEmptyArchive: true
            }
        }
        stage('Check Report') {
            steps {
                sh 'ls -l snyk_report.html'
            }
        }
        stage('Deploy') {
            steps {
                echo 'Deploying...'
                // Your deploy steps go here
            }
        }
    }
    
    post {
        success {
            emailext (
                subject: "Snyk Report - Build Successful",
                body: """
                    <p>Hi,</p>
                    <p>The build has been successful. The Snyk report is attached.</p>
                    <p>Regards,<br>Jenkins</p>
                """,
                to: 'recipient@example.com',
                attachmentsPattern: '**/snyk_report.html', // Ensuring it looks in all directories
                attachLog: false // Disable log attachment to isolate the issue
            )
        }
        failure {
            emailext (
                subject: "Snyk Report - Build Failed",
                body: """
                    <p>Hi,</p>
                    <p>The build has failed. The Snyk report is attached.</p>
                    <p>Regards,<br>Jenkins</p>
                """,
                to: 'recipient@example.com',
                attachmentsPattern: '**/snyk_report.html',
                attachLog: false
            )
        }
    }
}
   
