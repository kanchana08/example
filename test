                // Convert Snyk JSON report to HTML using snyk-to-html tool
                sh '''
                    /var/lib/jenkins/tools/io.snyk.jenkins.tools.SnykInstallation/snyk_latest/snyk-to-html-linux -i snyk_report.json -o snyk_report.html
                '''
            }
        }

        stage('Archive Report') {
            steps {
                echo 'Archiving Snyk Report...'
                archiveArtifacts artifacts: 'snyk_report.html', allowEmptyArchive: true
