pipeline {
    agent any
    tools {nodejs "npm"}
    environment {
        SNYK_API = "${env.SNYK_API}"  
    }

    stages {
        stage('checkout') {
            steps {
                git branch: 'master', credentialsId: 'PAT', url: 'https://git.stldev.io:1305/pradeepkumar.n/angular-ng.git'
            }
        }
        stage('Build') {
            steps {
                echo 'Building...'
                sh "npm install"
                sh "npm run build"
            }
        }
        stage('Test') {
            steps {
                echo 'Testing...'
                snykSecurity(
                    snykInstallation: 'snyk@latest',
                    snykTokenId: 'snyk-token',
                    // Additional parameters as needed
                )
            }
        }
        stage('Deploy') {
            steps {
                echo 'Deploying...'
                // Your deploy steps go here
            }
        }
    }
    
    post {
        success {
            // Send email with Snyk report attached
            emailext (
                to: "kanchanagm@stellaripl.com",
                subject: "Jenkins build: ${currentBuild.currentResult} - ${env.JOB_NAME}",
                body: """${currentBuild.currentResult}: Job ${env.JOB_NAME}
                         More Info can be found here: ${env.BUILD_URL}""",
                attachmentsPattern: '**/snyk_reports.html', // Assuming the Snyk report is saved with this name
                mimeType: 'text/html' // Set MIME type for the attachment if needed
            )
        }
    }
}


