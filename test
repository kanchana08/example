pipeline {
    agent any
    tools { nodejs "npm" }
    environment {
        SNYK_API = "${env.SNYK_API}"  
    }

    stages {
        stage('checkout') {
            steps {
                git branch: 'master', credentialsId: 'PAT', url: 'https://git.stldev.io:1305/pradeepkumar.n/angular-ng.git'
            }
        }
        stage('Build') {
            steps {
                echo 'Building...'
                sh "npm install"
                sh "npm run build"
            }
        }
        stage('Test') {
            steps {
                echo 'Testing...'
                snykSecurity(
                    snykInstallation: 'snyk@latest',
                    snykTokenId: 'snyk-token',
                    //place other parameters here
                )

                // Find the dynamically generated Snyk JSON report and convert it to HTML
                script {
                    def snykJsonFile = sh(
                        script: "ls ${WORKSPACE}/*_snyk_report.json",
                        returnStdout: true
                    ).trim()
                    
                    if (snykJsonFile) {
                        echo "Found Snyk report: ${snykJsonFile}"
                        sh "/var/lib/jenkins/tools/io.snyk.jenkins.tools.SnykInstallation/snyk_latest/snyk-to-html-linux -i ${snykJsonFile} -o ${WORKSPACE}/snyk_report.html"
                    } else {
                        error "Snyk JSON report not found!"
                    }
                }
            }
        }
        stage('Deploy') {
            steps {
                echo 'Deploying...'
                // Your deploy steps go here
            }
        }
    }

    post {
        success {
            // Archive the Snyk HTML report
            archiveArtifacts artifacts: 'snyk_report.html', allowEmptyArchive: true
            
            // Send the email with the HTML report attached
            emailext(
                to: 'kanchanagm@stellaripl.com',
                subject: "Jenkins Build: ${currentBuild.currentResult}: ${env.JOB_NAME}",
                body: """${currentBuild.currentResult}: Job ${env.JOB_NAME}
                More Info can be found here: ${env.BUILD_URL}""",
                attachLog: true,
                attachmentsPattern: 'snyk_report.html'
            )
        }
    }
}
