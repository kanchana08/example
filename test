pipeline {
    agent any
    tools { nodejs "npm" }
    environment {
        SNYK_API = "${env.SNYK_API}"  
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'master', credentialsId: 'PAT', url: 'https://git.stldev.io:1305/pradeepkumar.n/angular-ng.git'
            }
        }
        stage('Build') {
            steps {
                echo 'Building...'
                sh "npm install"
                sh "npm run build"
            }
        }
        stage('Test') {
            steps {
                echo 'Running Snyk Test...'
                // Run Snyk Security test and output report in workspace
                snykSecurity(
                    snykInstallation: 'snyk@latest',
                    snykTokenId: 'snyk-token',
                )
                
                // List all files in the current directory to check if the JSON report exists
                echo 'Listing files in the workspace:'
                sh 'ls -R'

                // Find the generated JSON report file
                script {
                    def jsonReportFile = sh(script: "find . -name '*_snyk_report.json'", returnStdout: true).trim()
                    echo "JSON Report File: ${jsonReportFile}"

                    // Check if the file was found
                    if (jsonReportFile) {
                        // Convert JSON report to HTML
                        def htmlReportFile = "snyk_report.html"
                        sh "/var/lib/jenkins/tools/io.snyk.jenkins.tools.SnykInstallation/snyk_latest/snyk-to-html-linux -i ${jsonReportFile} -o ${htmlReportFile}"

                        // List files again to confirm the report generation
                        sh 'ls -R'
                    } else {
                        error "JSON report file not found!"
                    }
                }

                // Archive the generated HTML report
                archiveArtifacts artifacts: 'snyk_report.html', allowEmptyArchive: true
            }
        }
        stage('Deploy') {
            steps {
                echo 'Deploying...'
                // Your deploy steps go here
            }
        }
    }

    post {
        success {
            // Send email with Snyk report as an attachment
            emailext attachLog: true,
                     attachmentsPattern: 'snyk_report.html',
                     subject: "Snyk Report - Build ${BUILD_NUMBER}",
                     body: """
                         Hello,

                         The Snyk security report for build #${BUILD_NUMBER} is attached.

                         Regards,
                         Jenkins
                     """,
                     to: 'recipient@example.com'
        }
    }
}
